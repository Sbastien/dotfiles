[user]
    name = {{ .name }}
    email = {{ .email }}

[core]
    editor = nvim
    # Replaces git's XDG default, so a ~/.config/git/ignore beside it would hold
    # rules that never apply. `git check-ignore -v` names the file that decided.
    excludesFile = ~/.gitignore
    autocrlf = input
    pager = delta

[init]
    defaultBranch = main

[diff]
    colorMoved = default
    algorithm = histogram

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true
    side-by-side = true
    # An unset delta style falls back to 24-bit; `delta --show-config` is the only
    # place those fallbacks are visible.
    syntax-theme = ansi
    # ANSI 16 has no tint faint enough to read code through, so the diff colour
    # goes on the foreground and overrides syntax. Necessary: the ansi theme paints
    # keys red and strings green, read as diff colours on a changed line.
    plus-style = "green"
    minus-style = "red"
    plus-emph-style = "green reverse"
    minus-emph-style = "red reverse"
    # delta strips these; with no background they are the unambiguous signal.
    keep-plus-minus-markers = true
    plus-empty-line-marker-style = "normal"
    minus-empty-line-marker-style = "normal"
    line-numbers-left-style = "brightblack dim"
    line-numbers-right-style = "brightblack dim"
    line-numbers-zero-style = "brightblack dim"
    line-numbers-minus-style = "red"
    line-numbers-plus-style = "green"
    file-style = "bold blue"
    file-decoration-style = "blue ul"
    hunk-header-style = "magenta"
    hunk-header-decoration-style = "brightblack box"
    commit-decoration-style = "bold yellow box ul"
    blame-code-style = syntax
    # Two stripes, because ANSI 16 carries two dark neutrals and not a ramp.
    blame-palette = "black brightblack"
    hyperlinks = true
    hyperlinks-file-link-format = "vscode://file/{path}:{line}"

[merge]
    conflictstyle = zdiff3

[rerere]
    enabled = true
    # Without it a replayed resolution is written to the worktree but left
    # unstaged, so the rerere hit looks like an unresolved conflict.
    autoUpdate = true

[tag]
    sort = version:refname

[rebase]
    autoSquash = true
    autoStash = true
    # Rebasing a stack moves the branches pointing inside it too, instead of
    # leaving them on the commits that were just rewritten.
    updateRefs = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[alias]
    s = status

    co = checkout
    cob = checkout -b
    br = branch

    cm = commit -m
    c = commit
    amend = commit --amend --no-edit
    wip = commit -m "WIP"
    fixup = commit --fixup

    a = add
    aa = add .

    p = push
    pl = pull
    pr = pull --rebase
    # Rebases onto the remote branch of the same name, never onto main.
    up = !git fetch origin && git rebase origin/$(git rev-parse --abbrev-ref HEAD)

    d = diff
    dc = diff --cached
    du = "!git -c delta.side-by-side=false diff"
    dcu = "!git -c delta.side-by-side=false diff --cached"

    lg = log --oneline --graph --decorate --all
    l = log --oneline --graph --decorate
    contributors = shortlog -sn --all --no-merges

    unstage = reset HEAD --
    undo = reset HEAD~1 --soft
{{ if .workEmail }}
[includeIf "gitdir:{{ .workDir | trimSuffix "/" }}/"]
    path = ~/.gitconfig.professional
{{ end }}
