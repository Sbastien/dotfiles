# Verified against Ghostty 1.3.1.
#
# There is deliberately no shell-integration line: `detect` is the default and
# Ghostty handles zsh itself. Unlike iTerm2, nothing gets sourced from .zshrc
# and nothing is paid at startup.

# A replacement needs brights distinct from their normals, yellow in palette 11
# (init.lua puts nvim's keywords there), and blue far enough from cyan to tell
# language versions from the git block.
theme = GitHub Dark Dimmed

# Taller x-height than FiraCode, so 12pt stays legible without costing columns.
font-family = JetBrainsMono Nerd Font Mono
font-size = 12

# Ghostty adds no leading of its own and packs rows tight enough that a diff
# reads as one block.
adjust-cell-height = 15%

window-padding-x = 12
window-padding-y = 12

cursor-style = bar
mouse-hide-while-typing = true

# Left only, so word motions carried over from iTerm2 keep working while right
# Option stays a macOS dead key. Holding a letter cannot type an accent here:
# Ghostty forwards the key repeats it should let the press-and-hold panel
# consume, so the panel opens over a row of repeats (ghostty-org/ghostty#10669).
macos-option-as-alt = left

# Asking before close interrupts more than it saves — the shell's own exit is
# the confirmation.
confirm-close-surface = false
window-save-state = always

# 0x0c is ctrl+l. Cmd is unencodable in terminal input, so the default
# clear_screen can only reach Ghostty's own buffer — and under herdr, which owns
# the grid and repaints over it, that looks like a dead key. Sending the byte
# reaches the pane's shell instead. Costs the scrollback purge outside herdr.
keybind = super+k=text:\x0c
