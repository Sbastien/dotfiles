typeset -U path PATH
export PATH="$HOME/.local/bin:$PATH"
export EDITOR="nvim"
# Without --color, fzf picks Dark256 on a 256-colour TERM and its greys come
# from the xterm cube, which no Ghostty theme touches.
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --color=16"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
# Must match HISTSIZE: zsh trims the file to SAVEHIST on exit, so a smaller
# value throws away the difference every time the shell closes.
SAVEHIST=50000
setopt extended_history hist_expire_dups_first hist_ignore_dups hist_ignore_space hist_verify share_history
setopt interactivecomments always_to_end complete_in_word
setopt auto_cd auto_pushd pushd_ignore_dups
# Otherwise a stray ^S freezes all output until ^Q, with nothing on screen to
# say why.
unsetopt flowcontrol

# Only alphanumerics count as word characters, so ^W eats one path segment
# instead of the whole path.
WORDCHARS=''

fpath=("$HOME/.local/share/zsh/plugins/zsh-completions/src" $fpath)
ZCOMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
mkdir -p "${ZCOMPDUMP:h}"
autoload -Uz compinit
# (Nmh-24) is one stat, empty unless the dump is under a day old, so -C holds for
# a day. It skips the security scan and the rebuild, which is 18 of compinit's
# ms. The cost: a completion installed today is not offered until the dump
# expires, silently. Delete the dump to pick one up now.
_zcd=("$ZCOMPDUMP"(Nmh-24))
compinit ${_zcd:+-C} -d "$ZCOMPDUMP"
unset _zcd
# This filesystem is case-insensitive, so case-sensitive completion refuses
# names the shell can already resolve: ~/docu -> ~/Documents.
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]-_}={[:upper:][:lower:]_-}'
# fzf-tab wants `no`, not the absence of the style: it reads the value to know
# it may capture the unambiguous prefix itself. `select` leaves zsh's own menu
# live on any widget fzf-tab does not handle.
zstyle ':completion:*' menu no
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --icons=auto --color=always $realpath'
# An empty spec still colourises, so this keeps working with LS_COLORS unset.
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# EDITOR=nvim matches the vi glob zsh uses to guess a keymap, so without this
# the shell comes up in viins and ^A/^E/^R stop behaving.
bindkey -e

autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[[3~' delete-char
# These literal forms are what the terminal sends outside application cursor
# mode, which nothing here turns on. Leaving ^[[1;5C/D unbound is worse than a
# dead key: ^[[1 is a live prefix, so zsh self-inserts the tail as `;5D`.
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

eval "$(mise activate zsh)"
eval "$(starship init zsh)"
eval "$(fzf --zsh)"
eval "$(zoxide init zsh)"
eval "$(command wt config shell init zsh)"

for f in "$HOME/.config/zshrc"/*.zsh(N); do source "$f"; done

# After compinit and after the local *.zsh glob, so nothing unmanaged rebinds
# ^I later; before the two plugins upstream calls widget wrappers.
source "$HOME/.local/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh"
source "$HOME/.local/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$HOME/.local/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
